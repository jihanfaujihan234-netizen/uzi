# Buat access key gratis di https://web3forms.com (pakai email tujuan kamu),
# lalu salin file ini menjadi .env.local dan isi nilainya.
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Komentar online (Supabase) - buat project gratis di https://supabase.com,
# lalu ambil URL dan anon/publishable key dari Project Settings > API Keys.
# Gunakan HANYA anon/public key. Jangan pernah memakai service_role/secret key di frontend.
# Kedua variabel ini wajib diisi agar komentar tampil untuk semua pengunjung.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
